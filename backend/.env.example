# ─── ACCENLEARN BACKEND SERVER ENVIRONMENT CONFIGURATION (TEMPLATE) ───────────
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
DB_NAME=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net

# Redis / Upstash Cache
REDIS_URL=https://dummy-url.upstash.io
REDIS_TOKEN=dummy_token

# Allowed Client Origins for CORS (Comma-separated)
FRONTEND_URL=http://localhost:5174,http://localhost:5173,https://accenlearn.com

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
CRON_SECRET=your_cron_secret_key_here

# Email Service (SMTP)
SMTP_NOREPLY_EMAIL=noreply@example.com
SMTP_NOREPLY_PASS="your_smtp_app_password"
SMTP_OPERATIONS_EMAIL=operation@example.com
SMTP_OPERATIONS_PASS="your_smtp_app_password"
DIKSHANNT_ADMIN_MAIL=operation@example.com
DIKSHANNT_LOGIN_URL=http://localhost:5174

# Cloudinary Media Storage
CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Amazon Web Services (AWS S3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Meta / Facebook Lead Webhook
META_VERIFY_TOKEN=your_meta_verify_token
META_APP_SECRET=your_meta_app_secret
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token

# Python Scraper Service
PYTHON_SERVICE_URL=http://localhost:8001
PYTHON_SERVICE_API_KEY=dev-key-123

# Attendance Geofence Configuration
OFFICE_LAT=12.916717
OFFICE_LNG=77.590068
ATTENDANCE_RADIUS_METERS=100
